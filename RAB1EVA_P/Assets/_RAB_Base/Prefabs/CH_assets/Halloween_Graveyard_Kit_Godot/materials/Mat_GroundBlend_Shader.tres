nodes/fragment/44/output_ports = "0,4,n_out;"
nodes/fragment/44/expression = "vec2 v = n.xy * 2.0 - 1.0;
float a = radians(angle_deg);
v = mat2(vec2(cos(a), -sin(a)), vec2(sin(a), cos(a))) * v;
n_out = vec3(v * 0.5 + 0.5, n.z);"
