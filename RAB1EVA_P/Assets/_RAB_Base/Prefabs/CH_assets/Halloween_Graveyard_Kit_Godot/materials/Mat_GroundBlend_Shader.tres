[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_kmasi"]
linked_parent_graph_frame = 93
size = Vector2(520, 360)
expression = "vec3 c = clamp(col, 0.0, 1.0);
vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
float d = q.x - min(q.w, q.y);
vec3 hsv = vec3(abs(q.z + (q.w - q.y) / (6.0 * d + 1e-10)), d / (q.x + 1e-10), q.x);
hsv.x = fract(hsv.x + hue / 360.0);
hsv.y = clamp(hsv.y * saturation, 0.0, 1.0);
vec4 K2 = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
vec3 pp = abs(fract(hsv.xxx + K2.xyz) * 6.0 - K2.www);
vec3 rgb = hsv.z * mix(K2.xxx, clamp(pp - K2.xxx, 0.0, 1.0), hsv.y);
rgb = lightness >= 0.0 ? mix(rgb, vec3(1.0), lightness) : rgb * (1.0 + lightness);
out_col = rgb;"

